    "test:dom": "node --test tests/dom-navigation.test.js",
    "test:links": "node --test tests/links.test.js",
    "test:security": "node --test tests/security.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "deploy": "npx --yes vercel --prod"
  },
  "keywords": [
    "wispr-flow",
    "growth-challenge",
    "voice-ai",
    "telemetry",
    "canto",
    "bangalore"
  ],
